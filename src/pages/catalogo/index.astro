---
/**
 * Catálogo de bolsas prontas (v2, estilo da página do Treinamento).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandChrome from '../../components/BrandChrome.astro';
import productsData from '../../data/products.json';
import { getProductImage } from '../../utils/productImages';
import { formatColor, colorHex } from '../../utils/colorLabels';
import type { Product } from '../../types/product';
import marilia from '../../assets/treinamento/marilia-bolsas.png';
import '../../styles/brand.css';

const products = (productsData.products as Product[]).filter((p) => p.inStock !== false);
const brl = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const tones = ['#e8dfd2', '#d9c7ad', '#c09a6b'];
---

<BaseLayout
  title="Bolsas prontas | Crochetin"
  description="Bolsas de crochê feitas à mão no ateliê da Crochetin, em Maceió. Escolha o modelo e a cor e peça pelo WhatsApp."
  wide
>
  <main class="b cat">
    <BrandChrome part="top" current="catalogo" />

    <div class="cat-head">
      <h1>Bolsas prontas</h1>
      <p>Feitas à mão no ateliê da Crochetin, em Maceió. Escolha o modelo e a cor e peça pelo WhatsApp.</p>
    </div>

    <ul class="cat-grid" role="list">
      {products.map((p, i) => {
        const img = getProductImage(p.images[0]);
        return (
          <li class="reveal">
            <a class="cat-card" href={`/catalogo/${p.slug}`}>
              <div class="cat-arch" style={`--tone:${tones[i % tones.length]}`}>
                {img && (
                  <Image
                    src={img}
                    alt={`${p.name} de crochê`}
                    widths={[360, 540, 720]}
                    sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
              <div class="cat-info">
                <h2>{p.name}</h2>
                <p class="cat-price">{brl(p.price)}</p>
              </div>
              {p.colors?.length > 0 && (
                <div class="cat-colors">
                  <ul role="list" aria-hidden="true">
                    {p.colors.map((c) => <li style={`background:${colorHex(c)}`} title={formatColor(c)} />)}
                  </ul>
                  <span>{p.colors.length} cores</span>
                </div>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <section class="cat-learn" aria-labelledby="learn-h">
      <div class="cat-learn-text reveal">
        <h2 id="learn-h">Quer fazer as suas?</h2>
        <p>Boa parte destas bolsas está no Treinamento Crochetin: 9 modelos em 45 aulas, com o acabamento do ateliê e o que fazer para vender.</p>
        <a class="b-arch-btn" href="/treinamento">Conhecer o Treinamento</a>
      </div>
      <div class="cat-learn-photo" aria-hidden="true">
        <Image src={marilia} alt="" widths={[400, 700]} sizes="(max-width: 860px) 70vw, 32vw" />
      </div>
    </section>

    <BrandChrome part="foot" />
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.querySelector('.b');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    root.querySelectorAll('.reveal').forEach(function (el, i) {
      el.style.setProperty('--d', (i % 3) * 80 + 'ms');
      el.classList.add('will-in');
      io.observe(el);
    });
  })();
</script>

<style>
  .cat-head { display: grid; grid-template-columns: 5fr 1fr 6fr; align-items: end; padding: clamp(24px, 4vw, 56px) 0 clamp(32px, 4vw, 56px); }
  .cat-head h1 { grid-column: 1; }
  .cat-head p { grid-column: 3; max-width: 44ch; }

  .cat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 4vw, 56px) var(--m); }
  .cat-card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; }
  .cat-arch { position: relative; aspect-ratio: 4 / 5; background: var(--tone); border-radius: 999px 999px 0 0; overflow: hidden; }
  .cat-arch :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .7s var(--ease); }
  .cat-card:hover .cat-arch :global(img) { transform: scale(1.04); }
  .cat-info { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .cat-info h2 { font-size: var(--t-m); }
  .cat-card:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; text-decoration-color: var(--accent); }
  .cat-price { font-weight: 600; white-space: nowrap; }
  .cat-colors { display: flex; align-items: center; gap: 12px; }
  .cat-colors ul { display: flex; gap: 6px; }
  .cat-colors li { width: 14px; height: 16px; border-radius: 999px 999px 0 0; }
  .cat-colors span { font-size: var(--t-s); color: var(--muted); }

  .cat-learn { margin-top: clamp(96px, 12vw, 200px); background: var(--ink); color: var(--ground); display: grid; grid-template-columns: 7fr 5fr; align-items: end; overflow: hidden; }
  .cat-learn-text { padding: clamp(32px, 5vw, 72px); align-self: center; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .cat-learn-text h2 { color: var(--pale); }
  .cat-learn-text p { max-width: 40ch; }
  .cat-learn-photo { align-self: end; background: var(--accent); border-radius: 999px 999px 0 0; margin: 48px 48px 0 0; aspect-ratio: 4 / 5; overflow: hidden; display: flex; align-items: flex-end; }
  .cat-learn-photo :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%; }

  @media (max-width: 1024px) {
    .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .cat-head { grid-template-columns: 1fr; gap: 16px; }
    .cat-head p { grid-column: 1; }
    .cat-grid { grid-template-columns: minmax(0, 1fr); }
    .cat-learn { grid-template-columns: 1fr; }
    .cat-learn-photo { margin: 0 24px; }
  }
</style>
