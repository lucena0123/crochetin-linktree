---
/**
 * Página de cada bolsa (v2, estilo da página do Treinamento).
 * Escolher a cor troca a foto e entra na mensagem do WhatsApp.
 * O botão "Comprar agora" (API própria) continua desligado em config.checkout.enabled
 * e foi retirado desta versão; o pedido é pelo WhatsApp.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandChrome from '../../components/BrandChrome.astro';
import productsData from '../../data/products.json';
import { formatColor, colorHex } from '../../utils/colorLabels';
import { getProductImage } from '../../utils/productImages';
import { withHotmartSource } from '../../utils/tracking';
import type { Product } from '../../types/product';
import '../../styles/brand.css';

export async function getStaticPaths() {
  const { products } = productsData as { products: Product[] };
  return products
    .filter((p) => p.inStock !== false)
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;
const all = (productsData.products as Product[]).filter((p) => p.inStock !== false);

const brl = (v: number) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const priceBRL = brl(product.price);
const installmentBRL = brl(product.price / 3);

// Foto de cada cor: o arquivo traz a cor no nome (bag-mari-preta.png)
const images = product.images.map((file) => ({
  file,
  img: getProductImage(file),
  color: product.colors.find((c) => file.includes(`-${c}.`)) ?? null,
}));
const firstColor = images[0]?.color ?? product.colors[0] ?? null;

const waBase = 'https://wa.me/5582996927755?text=';
const waMessage = (color: string | null) =>
  `Olá! Tenho interesse na *${product.name}* (${priceBRL})` + (color ? `, na cor *${formatColor(color)}*.` : '.');
const waHref = waBase + encodeURIComponent(waMessage(firstColor));

const d = product.dimensions;
const fmt = (n: number) => n.toLocaleString('pt-BR');
const measures = d && d.width
  ? (d.depth ? `${fmt(d.width)} × ${fmt(d.height)} × ${fmt(d.depth)} cm` : `${fmt(d.width)} × ${fmt(d.height)} cm (aproximado)`)
  : null;
const measuresHint = d && d.depth ? '(largura × altura × profundidade)' : '(largura × altura)';

const others = all.filter((p) => p.slug !== product.slug).slice(0, 4);

const heroSrc = images[0]?.img?.src ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: heroSrc ? `https://crochetin.com.br${heroSrc}` : undefined,
  brand: { '@type': 'Brand', name: 'Crochetin' },
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    url: `https://crochetin.com.br/catalogo/${product.slug}`,
  },
};
---

<BaseLayout title={`${product.name} | Crochetin`} description={product.description} image={heroSrc} wide>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main class="b pd">
    <BrandChrome part="top" current="catalogo" />

    <div class="pd-main">
      <div class="pd-media">
        <div class="pd-arch">
          {images.map((e, i) => e.img && (
            <Image
              class={i === 0 ? 'is-on' : ''}
              data-color={e.color ?? ''}
              src={e.img}
              alt={`${product.name}${e.color ? ` na cor ${formatColor(e.color)}` : ''}`}
              widths={[480, 720, 960]}
              sizes="(max-width: 860px) 92vw, 50vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          ))}
        </div>
      </div>

      <div class="pd-info">
        <h1>{product.name}</h1>
        <p class="pd-price">{priceBRL} <span>ou 3x de {installmentBRL} sem juros</span></p>
        {product.colors.length > 0 && (
          <fieldset class="pd-colors">
            <legend>Cor: <strong data-color-label>{firstColor ? formatColor(firstColor) : ''}</strong></legend>
            <div class="pd-swatches">
              {product.colors.map((c) => (
                <button
                  type="button"
                  class="pd-swatch"
                  data-color={c}
                  data-label={formatColor(c)}
                  aria-pressed={c === firstColor ? 'true' : 'false'}
                  aria-label={formatColor(c)}
                  title={formatColor(c)}
                >
                  <span style={`background:${colorHex(c)}`}></span>
                </button>
              ))}
            </div>
          </fieldset>
        )}

        <a
          class="b-arch-btn pd-cta"
          href={waHref}
          target="_blank"
          rel="noopener"
          data-wa-base={waBase}
          data-wa-name={product.name}
          data-wa-price={priceBRL}
        >Pedir pelo WhatsApp</a>
        <p class="pd-note">A cor, o prazo e o frete você combina direto com a Marília.</p>
        <p class="pd-desc">{product.description}</p>

        <dl class="pd-specs">
          {measures && <div><dt>Medidas</dt><dd>{measures} <small>{measuresHint}</small></dd></div>}
          {product.material && <div><dt>Material</dt><dd>{product.material}</dd></div>}
          <div><dt>Feita</dt><dd>100% à mão, no ateliê da Crochetin</dd></div>
          <div><dt>Troca</dt><dd>7 dias para troca ou devolução</dd></div>
        </dl>
      </div>
    </div>

    <section class="pd-learn reveal" aria-labelledby="learn-h">
      <div class="pd-learn-text">
        <h2 id="learn-h">Aprenda a fazer a {product.name.replace(/^Bag /, '')}</h2>
        <p>
          {product.lessons
            ? `Ela tem ${product.lessons} aulas no Treinamento Crochetin, do início ao acabamento.`
            : 'Ela faz parte do Treinamento Crochetin, do início ao acabamento.'}
        </p>
      </div>
      <div class="pd-learn-options">
        {product.lessonUrl && (
          <a class="pd-option" href={withHotmartSource(product.lessonUrl, `produto_${product.slug}`)} target="_blank" rel="noopener">
            <span class="pd-option-name">Só esta aula</span>
            <span class="pd-option-price">R$ 37</span>
          </a>
        )}
        <a class="pd-option is-main" href="/treinamento">
          <span class="pd-option-name">Treinamento com as 9 bolsas</span>
          <span class="pd-option-price">R$ 197</span>
        </a>
      </div>
    </section>

    <section class="pd-more" aria-labelledby="more-h">
      <h2 id="more-h">Outras bolsas</h2>
      <ul class="pd-more-grid" role="list">
        {others.map((p) => {
          const img = getProductImage(p.images[0]);
          return (
            <li>
              <a class="reveal" href={`/catalogo/${p.slug}`}>
                <div class="pd-more-arch">{img && <Image src={img} alt={p.name} widths={[300, 480]} sizes="(max-width: 700px) 45vw, 22vw" />}</div>
                <span class="pd-more-name">{p.name}</span>
                <span class="pd-more-price">{brl(p.price)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <BrandChrome part="foot" />
  </main>

  <script is:inline set:html={`
    if (typeof fbq !== 'undefined') {
      fbq('track', 'ViewContent', { content_name: ${JSON.stringify(product.name)}, content_ids: [${JSON.stringify(product.slug)}], content_type: 'product', value: ${product.price}, currency: 'BRL' });
    }
  `} />
  <script is:inline>
    (function () {
      var root = document.querySelector('.pd');
      if (!root) return;
      var imgs = root.querySelectorAll('.pd-arch img');
      var label = root.querySelector('[data-color-label]');
      var cta = root.querySelector('.pd-cta');
      root.querySelectorAll('.pd-swatch').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var color = btn.dataset.color;
          root.querySelectorAll('.pd-swatch').forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
          if (label) label.textContent = btn.dataset.label;
          var match = null;
          imgs.forEach(function (im) { if (im.dataset.color === color) match = im; });
          if (match) imgs.forEach(function (im) { im.classList.toggle('is-on', im === match); });
          if (cta) {
            var msg = 'Olá! Tenho interesse na *' + cta.dataset.waName + '* (' + cta.dataset.waPrice + '), na cor *' + btn.dataset.label + '*.';
            cta.href = cta.dataset.waBase + encodeURIComponent(msg);
          }
        });
      });
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        root.classList.add('js');
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -10% 0px' });
        root.querySelectorAll('.reveal').forEach(function (el, i) { el.style.setProperty('--d', (i % 4) * 80 + 'ms'); el.classList.add('will-in'); io.observe(el); });
      }
      if (cta) cta.addEventListener('click', function () {
        if (typeof fbq !== 'undefined') fbq('track', 'InitiateCheckout');
      });
    })();
  </script>
</BaseLayout>

<style>
  .pd-main { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); padding-top: clamp(16px, 3vw, 48px); align-items: start; }
  .pd-media { position: sticky; top: 24px; }
  .pd-arch { position: relative; aspect-ratio: 1 / 1; background: var(--sand); border-radius: 999px 999px 0 0; overflow: hidden; }
  .pd-arch :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s ease; }
  .pd-arch :global(img.is-on) { opacity: 1; }

  .pd-info { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-top: 8px; }
  .pd-price { font: 700 var(--t-m)/1.2 var(--font-sans); }
  .pd-price span { display: block; font-size: var(--t-s); font-weight: 400; color: var(--muted); margin-top: 4px; }
  .pd-desc { max-width: 46ch; }

  .pd-colors { border: 0; padding: 0; margin: 0; }
  .pd-colors legend { padding: 0; margin-bottom: 10px; font-size: var(--t-s); }
  .pd-swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .pd-swatch { width: 48px; height: 52px; padding: 4px; border: 0; background: transparent; cursor: pointer; border-radius: 999px 999px 0 0; display: flex; }
  .pd-swatch span { flex: 1; border-radius: 999px 999px 0 0; outline: 1px solid rgba(62, 47, 37, .18); outline-offset: -1px; }
  .pd-swatch[aria-pressed="true"] { background: var(--ink); }
  .pd-swatch:hover:not([aria-pressed="true"]) { background: var(--pale); }

  .pd-cta { margin-top: 8px; }
  .pd-note { font-size: var(--t-s); color: var(--muted); margin-top: -8px; }

  .pd-specs { width: 100%; margin: 12px 0 0; display: grid; gap: 4px; }
  .pd-specs div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 14px 18px; background: var(--sand); }
  .pd-specs dt { font-weight: 600; font-size: var(--t-s); }
  .pd-specs dd { margin: 0; font-size: var(--t-s); }
  .pd-specs small { display: block; font-size: inherit; color: var(--muted); }

  .pd-learn { margin-top: clamp(96px, 12vw, 180px); background: var(--accent); padding: clamp(28px, 4vw, 56px); display: grid; grid-template-columns: 6fr 6fr; gap: 24px 48px; align-items: end; }
  .pd-learn-text { display: flex; flex-direction: column; gap: 12px; }
  .pd-learn-text p { max-width: 38ch; }
  .pd-learn-options { display: grid; gap: 8px; }
  .pd-option { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; padding: 0 24px; background: var(--pale); text-decoration: none; font-weight: 600; transition: background-color .25s ease; }
  .pd-option:hover { background: var(--sand); }
  .pd-option.is-main { background: var(--ink); color: var(--ground); }
  .pd-option.is-main:hover { background: #2b2019; }
  .pd-option-price { font: 700 var(--t-m)/1 var(--font-serif); white-space: nowrap; }

  .pd-more { margin-top: clamp(72px, 9vw, 140px); }
  .pd-more h2 { margin-bottom: 32px; }
  .pd-more-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--m); }
  .pd-more-grid a { display: flex; flex-direction: column; gap: 8px; text-decoration: none; }
  .pd-more-arch { aspect-ratio: 4 / 5; background: var(--sand); border-radius: 999px 999px 0 0; overflow: hidden; }
  .pd-more-arch :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .pd-more-grid a:hover :global(img) { transform: scale(1.04); }
  .pd-more-name { font: 700 var(--t-m)/1.15 var(--font-serif); }
  .pd-more-price { font-size: var(--t-s); }

  @media (max-width: 860px) {
    .pd-main { grid-template-columns: minmax(0, 1fr); }
    .pd-media { position: static; }
    .pd-learn { grid-template-columns: minmax(0, 1fr); }
    .pd-more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pd-cta { align-self: stretch; }
  }
</style>
