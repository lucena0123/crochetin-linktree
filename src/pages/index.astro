---
/**
 * Página inicial (v2, estilo da marca). É onde o link da bio (/ig) leva,
 * então é pensada primeiro para o celular: o Treinamento em destaque e os
 * outros caminhos logo abaixo.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandChrome from '../components/BrandChrome.astro';
import LeadCapture from '../components/LeadCapture.astro';
import config from '../data/config.json';
import marilia from '../assets/treinamento/marilia-bolsas.png';
import mariliaVerde from '../assets/treinamento/marilia-bolsa-verde.png';
import lieta from '../assets/products/bag-lieta-caramelo.jpg';
import productsData from '../data/products.json';
import '../styles/brand.css';

const { profile, social } = config;
const bagCount = productsData.products.filter((p) => p.inStock !== false).length;

const paths = [
  { title: 'Bolsas prontas', text: `${bagCount} modelos feitos à mão, para pedir pelo WhatsApp`, href: '/catalogo', img: lieta, fit: 'cover', tone: '#e8dfd2' },
  { title: 'Aulas avulsas', text: 'Aprenda uma bolsa por vez, a partir de R$ 37', href: '/aulas-avulsas', img: mariliaVerde, fit: 'contain', tone: '#c09a6b' },
  { title: 'Materiais', text: 'Fios, alças e acessórios para as suas bolsas', href: '/materiais', img: null, fit: 'cover', tone: '#d9c7ad' },
];
---

<BaseLayout
  title="Crochetin | Bolsas de crochê, Treinamento e aulas"
  description={profile.bio}
  image={profile.image}
  wide
>
  <main class="b home">
    <header class="home-profile">
      <img class="home-logo" src={profile.image} alt="Crochetin" width="88" height="88" />
      <h1>{profile.name}</h1>
      <p>{profile.bio}</p>
    </header>

    <LeadCapture />

    <a class="home-feature" href="/treinamento">
      <div class="home-feature-text">
        <h2>Treinamento Crochetin</h2>
        <p>9 bolsas de alto padrão para fazer e vender, em 45 aulas.</p>
        <p class="home-feature-price">R$ 197 ou 12x de R$ 20,37</p>
        <span class="b-arch-btn">Conhecer o Treinamento</span>
      </div>
      <div class="home-feature-photo" aria-hidden="true">
        <Image src={marilia} alt="" widths={[360, 600]} sizes="(max-width: 700px) 60vw, 300px" loading="eager" />
      </div>
    </a>

    <ul class="home-paths" role="list">
      {paths.map((p) => (
        <li>
          <a class="home-path" href={p.href}>
            <span class="home-path-arch" style={`--tone:${p.tone}`} aria-hidden="true">
              {p.img
                ? <Image src={p.img} alt="" widths={[160, 240]} sizes="96px" class={`is-${p.fit}`} />
                : <img src="/images/materiais.png" alt="" width="96" height="96" class="is-top" loading="lazy" />}
            </span>
            <span class="home-path-text">
              <span class="home-path-title">{p.title}</span>
              <span class="home-path-sub">{p.text}</span>
            </span>
            <span class="home-path-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="home-social">
      <a href={social.instagram} target="_blank" rel="noopener">Instagram @crochetinatelie</a>
      <a href={social.whatsapp} target="_blank" rel="noopener">Falar no WhatsApp</a>
    </div>

    <BrandChrome part="foot" />
  </main>
</BaseLayout>

<style>
  .home { max-width: 640px; margin: 0 auto; }
  .home-profile { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 40px 0 28px; }
  .home-logo { width: 88px; height: 88px; border-radius: 999px; }
  .home-profile h1 { font-size: clamp(28px, 6vw, 36px); }
  .home-profile p { max-width: 34ch; color: var(--muted); }

  .home-feature { display: grid; grid-template-columns: 1fr 42%; align-items: end; background: var(--accent); text-decoration: none; overflow: hidden; border-radius: 180px 180px 0 0; padding-top: 28px; transition: background-color .25s ease; }
  .home-feature:hover { background: #c8a477; }
  .home-feature-text { padding: 48px 0 28px 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .home-feature-text h2 { font-size: clamp(28px, 5.4vw, 38px); }
  .home-feature-text p { font-size: var(--t-s); }
  .home-feature-price { font-weight: 700; font-size: 17px !important; }
  .home-feature-text .b-arch-btn { margin-top: 8px; font-size: var(--t-s); padding: 14px 22px 12px; min-height: 48px; }
  .home-feature:hover .b-arch-btn { background: #2b2019; transform: translateY(-3px); }
  .home-feature-photo { align-self: end; height: 100%; display: flex; align-items: flex-end; }
  .home-feature-photo :global(img) { width: 100%; height: auto; display: block; }

  .home-paths { display: grid; gap: 8px; margin-top: 8px !important; }
  .home-path { display: grid; grid-template-columns: 96px 1fr auto; gap: 16px; align-items: center; background: var(--sand); padding: 12px 20px 0 12px; text-decoration: none; transition: background-color .25s ease; }
  .home-path:hover { background: var(--pale); }
  .home-path-arch { width: 96px; height: 108px; background: var(--tone); border-radius: 999px 999px 0 0; overflow: hidden; display: flex; align-items: flex-end; }
  .home-path-arch :global(img) { width: 100%; height: 100%; }
  .home-path-arch :global(img.is-cover) { object-fit: cover; }
  .home-path-arch :global(img.is-contain) { object-fit: contain; object-position: 50% 100%; }
  .home-path-arch .is-top { object-fit: cover; object-position: 50% 0%; }
  .home-path-text { display: flex; flex-direction: column; gap: 4px; padding-bottom: 12px; }
  .home-path-title { font: 700 var(--t-m)/1.15 var(--font-serif); }
  .home-path-sub { font-size: var(--t-s); color: var(--muted); }
  .home-path-go { font-size: 22px; padding-bottom: 12px; transition: transform .3s var(--ease); }
  .home-path:hover .home-path-go { transform: translateX(4px); }

  .home-social { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; margin-top: 32px; }
  .home-social a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; font-size: var(--t-s); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 5px; }

  .home :global(.b-foot) { margin-top: 56px; }

  @media (max-width: 420px) {
    .home-feature { grid-template-columns: 1fr 40%; border-radius: 120px 120px 0 0; }
    .home-feature-text { padding: 40px 0 22px 20px; }
    .home-path { grid-template-columns: 80px 1fr auto; gap: 12px; padding-right: 14px; }
    .home-path-arch { width: 80px; height: 92px; }
  }
</style>
