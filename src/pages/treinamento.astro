---
/**
 * Página de vendas do Treinamento Crochetin — PROTÓTIPO v2 (branch, não publicado).
 * Imagens: as mesmas da página de vendas atual no Hotmart Pages (crochetin.hotmart.host).
 * Base de conteúdo: briefing de 01/11/2026 + conteúdo real da página atual
 * (Método Crochetin em 3 níveis, bônus, garantia).
 * Trechos com class="placeholder" aguardam material ou confirmação.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withHotmartSource } from '../utils/tracking';

import marilia from '../assets/treinamento/marilia-bolsas.png';
import mariliaVerde from '../assets/treinamento/marilia-bolsa-verde.png';
import nivel1 from '../assets/treinamento/nivel-1.png';
import nivel2 from '../assets/treinamento/nivel-2.png';
import nivel3 from '../assets/treinamento/nivel-3.png';
import garantia from '../assets/treinamento/garantia-7-dias.png';
import cliente1 from '../assets/treinamento/cliente-1.png';
import cliente2 from '../assets/treinamento/cliente-2.png';
import cliente3 from '../assets/treinamento/cliente-3.png';
import cliente4 from '../assets/treinamento/cliente-4.png';
import lieta from '../assets/treinamento/bolsa-lieta-caramelo.png';
import cherry from '../assets/treinamento/bolsa-cherry-caramelo.png';
import mari from '../assets/treinamento/bolsa-mari-dourada.png';
import atena from '../assets/treinamento/bolsa-atena-vermelha.png';
import ariel from '../assets/treinamento/bolsa-ariel-turquesa.png';
import tati from '../assets/treinamento/bolsa-tati.png';
import emy from '../assets/treinamento/bolsa-emy-colors.png';

const CHECKOUT = 'https://pay.hotmart.com/T101474588W?off=dliwfsqx';
const checkout = (sck: string) => withHotmartSource(CHECKOUT, `treinamento_${sck}`);
const whatsapp =
  'https://wa.me/5582996927755?text=' +
  encodeURIComponent('Olá! Tenho uma dúvida sobre o Treinamento Crochetin.');

// Aulas por bolsa = páginas de cada módulo na área de membros (Hotmart, 01/11/2026)
const bags = [
  { name: 'Liêta', lessons: 5, img: lieta },
  { name: 'Cherry', lessons: 4, img: cherry },
  { name: 'Mari', lessons: 5, img: mari },
  { name: 'Atena', lessons: 4, img: atena },
  { name: 'Ariel', lessons: 3, img: ariel },
  { name: 'Tati', lessons: 3, img: tati },
  { name: 'Emy Colors', lessons: 6, img: emy },
  { name: 'Rosália', lessons: 6, img: null },
  { name: 'Pochete Copa', lessons: 9, img: null },
];
const totalLessons = bags.reduce((s, b) => s + b.lessons, 0);

const levels = [
  {
    img: nivel1, title: 'Pete-Repete', level: 'Nível 1',
    text: 'A repetição é a sua aliada. Você ganha firmeza nas mãos, entende a estrutura das tramas e faz as primeiras bolsas com confiança e ritmo.',
  },
  {
    img: nivel2, title: 'Firme e Forte', level: 'Nível 2',
    text: 'Hora de evoluir o acabamento: dar forma e firmeza à peça e deixar cada detalhe mais preciso e sofisticado.',
  },
  {
    img: nivel3, title: 'Crochetin', level: 'Nível 3',
    text: 'Você replica os modelos com perfeição e chega ao padrão Crochetin: técnica impecável, estrutura sólida e acabamento de luxo.',
  },
];

const bonuses = [
  'E-books com a receita escrita de todas as bolsas',
  'Como precificar o seu crochê',
  'Como embalar com capricho',
  'Como enviar para todo o Brasil',
  'Suporte pelo WhatsApp direto com a Marília',
  'Certificado digital ao concluir as aulas',
  'Atualizações do curso com novos modelos',
];

const chats = [cliente1, cliente2, cliente3, cliente4];
---

<BaseLayout
  title="Treinamento Crochetin — 9 bolsas de alto padrão para fazer e vender"
  description="Aprenda a fazer 9 bolsas de crochê de alto padrão e a precificar, embalar e enviar para vender."
  wide
  noindex
>
  <main class="tr">
    <!-- Topo: Marília com as bolsas -->
    <header class="tr-hero">
      <div class="tr-hero-text">
        <p class="tr-brand">Treinamento Crochetin</p>
        <h1>Bolsas de crochê que encantam, vendem e levam o seu nome.</h1>
        <p class="tr-lead">
          9 bolsas de alto padrão em {totalLessons} aulas, e tudo o que vem depois da última carreira:
          quanto cobrar, como embalar e como enviar.
        </p>
        <a class="tr-btn" href={checkout('topo')} target="_blank" rel="noopener">Quero o Treinamento</a>
        <p class="tr-price-inline">R$ 197 à vista ou 12x de R$ 20,37 · acesso imediato</p>
      </div>
      <div class="tr-hero-figure">
        <Image src={marilia} alt="Marília Lucena segurando várias bolsas Crochetin coloridas" widths={[420, 720, 1000]} sizes="(max-width: 860px) 90vw, 45vw" loading="eager" />
      </div>
    </header>

    <!-- As 9 bolsas -->
    <section class="tr-bags-section" aria-labelledby="bolsas">
      <div class="tr-wrap">
        <h2 id="bolsas">As 9 bolsas que você vai fazer</h2>
        <p class="tr-sub">Cada bolsa tem o seu módulo, com aulas em sequência e a receita escrita em e-book.</p>
        <ul class="tr-bags">
          {bags.map((b) => (
            <li class="tr-bag">
              <div class="tr-bag-photo">
                {b.img ? (
                  <Image src={b.img} alt={`Bag ${b.name}`} widths={[400, 700]} sizes="(max-width: 600px) 50vw, 30vw" />
                ) : (
                  <span class="placeholder">Foto da {b.name} a enviar</span>
                )}
              </div>
              <p class="tr-bag-name">{b.name}</p>
              <p class="tr-bag-meta">{b.lessons} aulas</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Método -->
    <section class="tr-method" aria-labelledby="metodo">
      <div class="tr-wrap">
        <h2 id="metodo">Método Crochetin</h2>
        <p class="tr-sub tr-sub-light">Três níveis, do primeiro modelo ao acabamento de luxo.</p>
        <ol class="tr-levels">
          {levels.map((l) => (
            <li>
              <Image src={l.img} alt="" widths={[200, 320]} sizes="160px" />
              <p class="tr-level-tag">{l.level}</p>
              <h3>{l.title}</h3>
              <p>{l.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Clientes -->
    <section class="tr-wrap tr-section" aria-labelledby="clientes">
      <h2 id="clientes">O que as clientes falam das bolsas Crochetin</h2>
      <p class="tr-sub">Elas compram, se apaixonam e indicam. É esse padrão que o Treinamento ensina.</p>
      <ul class="tr-chats">
        {chats.map((c, i) => (
          <li><Image src={c} alt={`Mensagem de cliente elogiando uma bolsa Crochetin (${i + 1})`} widths={[280, 440]} sizes="(max-width: 600px) 45vw, 22vw" /></li>
        ))}
      </ul>
      <p class="placeholder tr-proof-note">Depoimentos de alunas do Treinamento, com autorização, a incluir aqui.</p>
    </section>

    <!-- Quem ensina -->
    <section class="tr-wrap tr-section tr-teacher" aria-labelledby="quem-ensina">
      <div class="tr-arch">
        <Image src={mariliaVerde} alt="Marília Lucena segurando a bolsa verde-militar" widths={[360, 600]} sizes="(max-width: 860px) 70vw, 30vw" />
      </div>
      <div>
        <h2 id="quem-ensina">Quem ensina</h2>
        <p>
          Marília Lucena é formada em Arquitetura e Urbanismo, mas foi no crochê que encontrou a sua paixão.
          Hoje é fundadora da Crochetin, marca de bolsas de crochê de alto padrão.
        </p>
        <p>
          No Treinamento ela ensina as mesmas bolsas que a Crochetin vende, da primeira carreira
          ao acabamento, e mostra como transformar a peça em negócio.
        </p>
      </div>
    </section>

    <!-- Oferta -->
    <section class="tr-offer" aria-labelledby="oferta">
      <div class="tr-wrap tr-offer-grid">
        <div>
          <h2 id="oferta">Tudo o que está incluído</h2>
          <ul class="tr-included">
            <li>9 bolsas completas, em {totalLessons} aulas</li>
            <li>Método Crochetin em 3 níveis</li>
            {bonuses.map((b) => <li>{b}</li>)}
          </ul>
        </div>
        <div class="tr-price-card">
          <p class="tr-compare"><span>As 9 aulas avulsas, uma a uma</span><s>R$ 333</s></p>
          <p class="tr-price-label">Treinamento completo</p>
          <p class="tr-price">12x de <strong>R$ 20,37</strong></p>
          <p class="tr-price-cash">ou R$ 197 à vista</p>
          <a class="tr-btn tr-btn-light" href={checkout('oferta')} target="_blank" rel="noopener">Quero o Treinamento</a>
          <p class="tr-secure">Pagamento pela Hotmart · acesso imediato</p>
        </div>
      </div>
    </section>

    <!-- Garantia -->
    <section class="tr-wrap tr-section tr-guarantee" aria-labelledby="garantia">
      <Image src={garantia} alt="Selo de garantia de 7 dias" widths={[160, 280]} sizes="140px" />
      <div>
        <h2 id="garantia">7 dias para testar</h2>
        <p>Entre, assista às aulas e comece a sua primeira bolsa. Se não for para você, peça o reembolso pela Hotmart dentro de 7 dias.</p>
      </div>
    </section>

    <p class="tr-wrap placeholder tr-upgrade">
      Já comprou uma aula avulsa? Leve o Treinamento pagando a diferença: R$ 160. [link da oferta de upgrade a criar na Hotmart]
    </p>

    <!-- FAQ -->
    <section class="tr-wrap tr-section" aria-labelledby="duvidas">
      <h2 id="duvidas">Perguntas frequentes</h2>
      <details>
        <summary>Quantos modelos vou aprender?</summary>
        <p>Hoje são 9 bolsas: Liêta, Cherry, Mari, Atena, Ariel, Tati, Emy Colors, Rosália e Pochete Copa. O curso recebe novos modelos com o tempo.</p>
      </details>
      <details>
        <summary>Preciso saber crochê para começar?</summary>
        <p class="placeholder">A confirmar com a Marília: o Treinamento ensina os pontos desde o zero ou parte de quem já faz correntinha, ponto baixo e ponto alto?</p>
      </details>
      <details>
        <summary>Qual a diferença para as aulas avulsas?</summary>
        <p>As aulas avulsas são as mesmas do Treinamento, vendidas por bolsa. No Treinamento você leva as 9 bolsas, o Método Crochetin e todos os bônus.</p>
      </details>
      <details>
        <summary>Por quanto tempo terei acesso?</summary>
        <p class="placeholder">Tempo de acesso a confirmar na Hotmart.</p>
      </details>
      <details>
        <summary>Quais materiais preciso?</summary>
        <p class="placeholder">Lista de fios, agulhas e ferragens por bolsa, a confirmar com a Marília.</p>
      </details>
      <details>
        <summary>E se eu não gostar?</summary>
        <p>Você tem 7 dias para pedir o reembolso pela Hotmart.</p>
      </details>
    </section>

    <!-- Ajuda -->
    <section class="tr-help">
      <div class="tr-wrap tr-help-inner">
        <h2>Ainda ficou com alguma dúvida?</h2>
        <a class="tr-btn" href={whatsapp} target="_blank" rel="noopener">Falar com a Crochetin no WhatsApp</a>
        <p class="tr-entry">Prefere começar por uma bolsa só? <a href="/aulas-avulsas">Veja as aulas avulsas por R$ 37</a>.</p>
      </div>
    </section>

    <footer class="tr-wrap tr-footer">
      <p class="placeholder">Crochetin · CNPJ, razão social e endereço a incluir · Política de privacidade · Política de reembolso</p>
    </footer>
  </main>
</BaseLayout>

<style>
  /* A página ocupa a largura toda; o container do layout vira só um invólucro */
  :global(body:has(.tr)) { background: #f4efe7; }
  :global(body:has(.tr))::before { display: none; }
  :global(.container:has(> .tr)) { max-width: none; padding: 0; }

  .tr {
    --caramel: #c09a6b;
    --caramel-deep: #a67d4f;
    --linen: #f4efe7;
    --sand: #e8dfd2;
    --ink: #3e2f25;
    --ink-soft: #6b5642;
    --white: #ffffff;
    color: var(--ink);
    font-family: var(--font-sans);
  }
  .tr-wrap { max-width: 1120px; margin: 0 auto; padding-left: clamp(1rem, 4vw, 2rem); padding-right: clamp(1rem, 4vw, 2rem); }

  .tr h1, .tr h2 { font-family: var(--font-serif); font-weight: 700; line-height: 1.12; letter-spacing: -0.01em; }
  .tr h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-bottom: 1.2rem; }
  .tr h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); margin-bottom: 0.6rem; }
  .tr h3 { font-size: 1.15rem; font-weight: 600; }
  .tr p, .tr li { font-size: 1.05rem; line-height: 1.65; }
  .tr-sub { color: var(--ink-soft); margin-bottom: 2rem; max-width: 60ch; }

  .tr-btn {
    display: inline-block; background: var(--ink); color: var(--white);
    font-weight: 600; font-size: 1.05rem; padding: 1rem 1.9rem; border-radius: 999px; text-decoration: none;
  }
  .tr-btn:hover { background: #2b2019; }
  .tr-btn-light { background: var(--white); color: var(--ink); }
  .tr-btn-light:hover { background: var(--linen); }
  .tr a:focus-visible, .tr summary:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }

  /* Topo */
  .tr-hero {
    background: var(--caramel);
    display: grid; grid-template-columns: 1fr 1fr; align-items: end;
    padding: 0 max(clamp(1rem, 4vw, 2rem), calc((100vw - 1120px) / 2));
    overflow: hidden;
  }
  .tr-hero-text { padding: 4.5rem 0 4rem; color: var(--ink); }
  .tr-brand { font-weight: 600; margin-bottom: 0.9rem; }
  .tr-lead { max-width: 46ch; margin-bottom: 2rem; }
  .tr-price-inline { margin-top: 1rem; font-weight: 500; }
  .tr-hero-figure { align-self: end; display: flex; justify-content: center; }
  .tr-hero-figure :global(img) { width: min(100%, 520px); height: auto; display: block; margin-top: 2rem; }

  /* Bolsas */
  .tr-bags-section { padding: 4.5rem 0; }
  .tr-bags { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 1.25rem; }
  .tr-bag-photo { aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background: var(--sand); display: grid; }
  .tr-bag-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tr-bag-name { font-family: var(--font-serif); font-size: 1.35rem; font-weight: 600; margin-top: 0.65rem; }
  .tr-bag-meta { color: var(--ink-soft); font-size: 0.95rem; }

  /* Método */
  .tr-method { background: var(--ink); color: var(--linen); padding: 4.5rem 0; }
  .tr-sub-light { color: #d9cbb8; }
  .tr-levels { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .tr-levels :global(img) { width: 140px; height: 140px; border-radius: 50%; display: block; margin-bottom: 1.1rem; background: var(--linen); }
  .tr-level-tag { color: var(--caramel); font-weight: 600; font-size: 0.95rem; }
  .tr-levels h3 { font-family: var(--font-serif); font-size: 1.6rem; margin-bottom: 0.5rem; }
  .tr-levels p:last-child { color: #e6dacb; }

  /* Seções claras */
  .tr-section { padding-top: 4.5rem; padding-bottom: 4.5rem; }
  .tr-chats { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .tr-chats :global(img) { width: 100%; height: auto; border-radius: 16px; display: block; }
  .tr-proof-note { margin-top: 1.5rem; }

  .tr-teacher { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 3rem; align-items: center; }
  .tr-teacher p { max-width: 58ch; margin-bottom: 0.9rem; }
  .tr-arch { background: var(--caramel); border-radius: 999px 999px 18px 18px; overflow: hidden; display: flex; justify-content: center; padding-top: 2rem; }
  .tr-arch :global(img) { width: 100%; height: auto; display: block; }

  /* Oferta */
  .tr-offer { background: var(--caramel); padding: 4.5rem 0; }
  .tr-offer-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
  .tr-included { padding-left: 1.2rem; }
  .tr-included li { margin-bottom: 0.35rem; }
  .tr-price-card { background: var(--ink); color: var(--linen); border-radius: 28px; padding: 2.5rem 2rem; text-align: center; }
  .tr-compare { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.95rem !important; color: #d9cbb8; border-bottom: 1px solid rgba(244,239,231,0.2); padding-bottom: 0.9rem; margin-bottom: 1.2rem; text-align: left; }
  .tr-price-label { font-weight: 600; }
  .tr-price { font-size: 1.3rem !important; }
  .tr-price strong { font-family: var(--font-serif); font-size: 3rem; display: block; line-height: 1.1; }
  .tr-price-cash { margin-bottom: 1.6rem; color: #e6dacb; }
  .tr-secure { margin-top: 0.9rem; font-size: 0.9rem !important; color: #d9cbb8; }

  .tr-guarantee { display: flex; gap: 2rem; align-items: center; }
  .tr-guarantee :global(img) { width: 140px; height: 140px; flex: none; border-radius: 50%; }
  .tr-guarantee p { max-width: 56ch; }
  .tr-upgrade { margin-bottom: 1rem; }

  .tr details { border-bottom: 1px solid rgba(62, 47, 37, 0.18); padding: 1rem 0; max-width: 780px; }
  .tr summary { cursor: pointer; font-weight: 600; font-size: 1.08rem; }
  .tr details p { margin-top: 0.6rem; color: var(--ink-soft); max-width: 70ch; }

  .tr-help { background: var(--sand); padding: 4rem 0; text-align: center; }
  .tr-help-inner h2 { margin-bottom: 1.4rem; }
  .tr-entry { margin-top: 1.4rem; }
  .tr-entry a { color: var(--ink); font-weight: 600; }
  .tr-footer { padding-top: 2rem; padding-bottom: 2rem; font-size: 0.9rem; }

  .placeholder {
    background: repeating-linear-gradient(45deg, rgba(166,125,79,0.08) 0 10px, rgba(166,125,79,0.18) 10px 20px);
    border: 1px dashed var(--caramel-deep); border-radius: 10px; padding: 1rem; color: var(--ink-soft); font-size: 0.95rem;
  }
  .tr-bag-photo .placeholder { border: none; border-radius: 0; display: grid; place-items: center; text-align: center; }

  @media (max-width: 860px) {
    .tr-hero { grid-template-columns: 1fr; }
    .tr-hero-text { padding: 2.5rem 0 0; }
    .tr-hero-figure :global(img) { width: min(88%, 420px); }
    .tr-bags { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 0.9rem; }
    .tr-levels { grid-template-columns: 1fr; gap: 2rem; }
    .tr-chats { grid-template-columns: repeat(2, 1fr); }
    .tr-teacher, .tr-offer-grid { grid-template-columns: 1fr; gap: 2rem; }
    .tr-arch { max-width: 360px; }
    .tr-guarantee { flex-direction: column; align-items: flex-start; }
    .tr-bag-name { font-size: 1.15rem; }
  }
</style>
