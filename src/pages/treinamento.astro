---
/**
 * Página de vendas do Treinamento Crochetin (v3, layout aprovado em 02/11/2026).
 * Direção de arte: taste-skill v2, direção "One motif" (seed 1971043266), paleta e tipos da marca.
 * Ideia: o arco da alça de uma bolsa Crochetin vira a máscara das fotos, o botão,
 * o marcador das listas e a faixa que divide a página.
 * Imagens: as da página de vendas atual no Hotmart Pages (próprias da Crochetin).
 * class="pending" marca, se reaparecer, conteúdo que ainda aguarda material da Crochetin.
 * Upgrade é pedido pelo WhatsApp: a Marília confere qual aula avulsa a cliente comprou e cobra
 * R$ 197 menos o valor pago. Aulas na Hotmart (02/11/2026): Tati e Emy R$ 37, Pochete Copa R$ 39,
 * Ariel, Atena e Rosália R$ 47, Mari R$ 57 → upgrade de R$ 140 a R$ 160.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withHotmartSource } from '../utils/tracking';
import productsData from '../data/products.json';
import type { Product } from '../types/product';

import marilia from '../assets/treinamento/marilia-bolsas.png';
import mariliaVerde from '../assets/treinamento/marilia-bolsa-verde.png';
import nivel1 from '../assets/treinamento/nivel-1.png';
import nivel2 from '../assets/treinamento/nivel-2.png';
import nivel3 from '../assets/treinamento/nivel-3.png';
import garantia from '../assets/treinamento/garantia-7-dias.png';
import cliente1 from '../assets/treinamento/cliente-1.png';
import cliente2 from '../assets/treinamento/cliente-2.png';
import cliente3 from '../assets/treinamento/cliente-3.png';
import cliente4 from '../assets/treinamento/cliente-4.png';
import lieta from '../assets/treinamento/bolsa-lieta-caramelo.png';
import cherry from '../assets/treinamento/bolsa-cherry-caramelo.png';
import mari from '../assets/treinamento/bolsa-mari-dourada.png';
import atena from '../assets/treinamento/bolsa-atena-vermelha.png';
import ariel from '../assets/treinamento/bolsa-ariel-turquesa.png';
import tati from '../assets/treinamento/bolsa-tati.png';
import emy from '../assets/treinamento/bolsa-emy-colors.png';
import rosalia from '../assets/treinamento/bolsa-rosalia.png';
import pochete from '../assets/treinamento/bolsa-pochete-copa.png';

const CHECKOUT = 'https://pay.hotmart.com/T101474588W?off=dliwfsqx';
const checkout = (sck: string) => withHotmartSource(CHECKOUT, `treinamento_${sck}`);
const whatsapp =
  'https://wa.me/5582996927755?text=' +
  encodeURIComponent('Olá! Tenho uma dúvida sobre o Treinamento Crochetin.');

// Aulas por bolsa = páginas de cada módulo na área de membros (Hotmart, 01/11/2026)
const bagList = [
  { name: 'Liêta', lessons: 5, img: lieta, tone: '#c09a6b', slug: 'bag-lieta' },
  { name: 'Cherry', lessons: 4, img: cherry, tone: '#a67d4f', slug: 'bag-cherry' },
  { name: 'Mari', lessons: 5, img: mari, tone: '#d9c7ad', slug: 'bag-mari' },
  { name: 'Atena', lessons: 4, img: atena, tone: '#c09a6b', slug: 'bag-atena' },
  { name: 'Ariel', lessons: 3, img: ariel, tone: '#d9c7ad', slug: 'bag-ariel' },
  { name: 'Tati', lessons: 3, img: tati, tone: '#a67d4f', slug: 'bag-tati' },
  { name: 'Emy Colors', lessons: 6, img: emy, tone: '#c09a6b', slug: 'bag-emy' },
  { name: 'Rosália', lessons: 6, img: rosalia, tone: '#d9c7ad', slug: 'bag-rosalia' },
  { name: 'Pochete Copa', lessons: 9, img: pochete, tone: '#a67d4f', slug: '' },
];
// Bolsa pronta e aula avulsa de cada bolsa, quando existem (products.json)
const productBySlug = new Map((productsData.products as Product[]).filter((p) => p.inStock !== false).map((p) => [p.slug, p]));
const bags = await Promise.all(
  bagList.map(async (b) => ({
    ...b,
    src: b.img ? (await getImage({ src: b.img, width: 900, format: 'webp' })).src : null,
    thumb: b.img ? (await getImage({ src: b.img, width: 240, format: 'webp' })).src : null,
    hasBag: productBySlug.has(b.slug),
    lessonPrice: productBySlug.get(b.slug)?.lessonPrice ?? null,
  })),
);
const totalLessons = bags.reduce((s, b) => s + b.lessons, 0);
const first = bags[0];

const stages = [
  { name: 'Pete-Repete', img: nivel1, text: 'Nível 1. A repetição é a sua aliada: firmeza nas mãos, a estrutura das tramas e as primeiras bolsas feitas com confiança e ritmo.' },
  { name: 'Firme e Forte', img: nivel2, text: 'Nível 2. Hora de evoluir o acabamento: dar forma e firmeza à peça e deixar cada detalhe mais preciso.' },
  { name: 'Crochetin', img: nivel3, text: 'Nível 3. Você replica os modelos com perfeição e chega ao padrão Crochetin: técnica impecável, estrutura sólida, acabamento de luxo.' },
  { name: 'Do ateliê à venda', img: null, text: 'Como precificar o seu crochê, embalar com capricho e enviar para todo o Brasil. É o que transforma a bolsa pronta em venda.' },
];

const chats = [cliente1, cliente2, cliente3, cliente4];
const chatsBig = await Promise.all(chats.map((c) => getImage({ src: c, width: 900, format: 'webp' })));
const extras = [
  ['E-books', 'A receita de todas as bolsas do Treinamento, para consultar enquanto faz.'],
  ['Precificação', 'Como calcular o preço do seu crochê sem trabalhar de graça.'],
  ['Embalagem', 'Como embalar com capricho, do jeito que a Crochetin entrega.'],
  ['Envio', 'Como enviar para todo o Brasil com segurança.'],
  ['Suporte', 'Tire dúvidas pelo WhatsApp direto com a Marília.'],
  ['Certificado', 'Certificado digital ao concluir as aulas.'],
  ['Novos modelos', 'Quando o Treinamento ganha bolsas novas, você recebe.'],
];

const faq = [
  { q: 'Quantos modelos vou aprender?', a: 'Hoje são 9 bolsas: Liêta, Cherry, Mari, Atena, Ariel, Tati, Emy Colors, Rosália e Pochete Copa. O curso recebe novos modelos com o tempo.' },
  { q: 'Preciso saber crochê para começar?', a: 'Sim. O Treinamento é para quem já sabe os pontos básicos do crochê. O “do zero” é da bolsa: você parte do fio de malha e chega a uma bolsa de verdade, com estrutura e acabamento de alto padrão.' },
  { q: 'Qual a diferença para as aulas avulsas?', a: 'As aulas avulsas são as mesmas do Treinamento, vendidas uma bolsa por vez. No Treinamento você leva as 9 bolsas, o Método Crochetin e todos os bônus.' },
  { q: 'O que vem junto com as aulas?', a: 'E-books com a receita escrita de cada bolsa, os módulos de precificação, embalagem e envio, suporte pelo WhatsApp direto com a Marília e certificado digital ao concluir.' },
  { q: 'Por quanto tempo terei acesso?', a: 'Você tem 1 ano de acesso a todas as aulas e bônus, contado a partir da data da compra.' },
  { q: 'E se eu não gostar?', a: 'Você tem 7 dias para pedir o reembolso pela Hotmart.' },
];
const upgradeWhatsapp =
  'https://wa.me/5582996927755?text=' +
  encodeURIComponent('Olá! Já comprei uma aula avulsa da Crochetin e quero fazer o upgrade para o Treinamento completo, descontando o valor da aula.');
const wordmark = 'Crochetin'.split('');
const blockTones = ['#6b5642', '#a67d4f', '#d9c7ad', '#3e2f25'];
---

<BaseLayout
  title="Treinamento Crochetin — aprenda a fazer as 9 bolsas da Crochetin"
  description="Curso online com 45 aulas: 9 bolsas de crochê de alto padrão, do acabamento à venda."
  wide
>
  <main class="tr">
    <!-- Topo: cartão listrado ao lado da foto -->
    <header class="hero" id="topo">
      <div class="hero-card">
        <div class="stitch" aria-hidden="true">{Array.from({ length: 24 }).map(() => <span />)}</div>
        <div class="hero-card-body">
          <img class="hero-logo" src="/images/logo-crochetin.png" alt="Crochetin" width="96" height="96" />
          <h1>As 9 bolsas da Crochetin</h1>
          <p class="hero-sub">
            Aprenda a fazer cada uma em {totalLessons} aulas online: das primeiras carreiras ao acabamento de luxo, e como precificar, embalar e enviar para vender.
          </p>
          <a class="arch-btn" href={checkout('topo')} target="_blank" rel="noopener">Quero o Treinamento</a>
          <p class="hero-price">R$ 197 à vista ou 12x de R$ 20,37</p>
        </div>
        <nav class="hero-links" aria-label="Nesta página">
          <a href="#bolsas">As bolsas</a>
          <a href="#metodo">O método</a>
          <a href="#preco">Preço</a>
        </nav>
      </div>
      <div class="hero-photo">
        <div class="hero-arch">
          <Image class="fade is-on" src={marilia} alt="Marília Lucena segurando várias bolsas Crochetin coloridas" widths={[500, 800, 1100]} sizes="(max-width: 860px) 90vw, 46vw" loading="eager" />
          <Image class="fade" src={mariliaVerde} alt="Marília Lucena segurando a bolsa verde-militar" widths={[500, 800, 1100]} sizes="(max-width: 860px) 90vw, 46vw" />
        </div>
      </div>
    </header>

    <!-- Vídeo da Marília (o mesmo da página atual na Hotmart); carrega só no clique -->
    <section class="video" aria-labelledby="video-h">
      <div class="video-text reveal">
        <h2 id="video-h">Assista antes de decidir</h2>
        <p>Bolsa de crochê virou febre, e ainda são poucas as artesãs com acabamento de luxo. A Marília mostra as bolsas e como o crochê vira faturamento.</p>
      </div>
      <div class="video-frame">
        <button type="button" class="video-play" data-id="uR5hVjrdMW4" aria-label="Assistir ao vídeo da Marília sobre o Treinamento, 10 minutos">
          <img src="https://i.ytimg.com/vi/uR5hVjrdMW4/maxresdefault.jpg" alt="" width="1280" height="720" loading="lazy" />
          <span class="video-label" aria-hidden="true"><span class="video-icon"></span>Assistir <span class="video-time">· 10 min</span></span>
        </button>
      </div>
    </section>

    <!-- Vitrine: escolha uma bolsa -->
    <section class="showcase" id="bolsas" aria-labelledby="bolsas-h">
      <div class="sc-head reveal">
        <h2 id="bolsas-h">As 9 bolsas</h2>
        <p>Toque numa bolsa para ver quantas aulas ela tem e onde encontrar a bolsa pronta.</p>
      </div>
      <div class="sc-stage">
        <div class="showcase-arch" style={`--tone:${first.tone}`}>
          {bags.map((b, i) => b.src ? (
            <img class={`bag-img${i === 0 ? ' is-on' : ''}`} data-i={i} src={b.src} alt={`Bolsa ${b.name}`} width="900" height="506" loading="lazy" />
          ) : (
            <p class="bag-img bag-missing pending" data-i={i}>Foto da {b.name} a enviar</p>
          ))}
        </div>
        <div class="showcase-fact" aria-live="polite">
          <p class="sc-count"><span data-f="n">01</span> / {String(bags.length).padStart(2, '0')}</p>
          <h3 data-f="name">{first.name}</h3>
          <p data-f="lessons">{first.lessons} aulas e a receita em e-book, dentro do Treinamento</p>
          <p class="fact-links">
            <a data-f="bag" href={first.hasBag ? `/catalogo/${first.slug}` : '/catalogo'} hidden={!first.hasBag}>Ver a bolsa pronta</a>
            <a data-f="lesson" href="/aulas-avulsas" hidden={!first.lessonPrice}>Aula avulsa {first.lessonPrice ? `R$ ${first.lessonPrice}` : ''}</a>
          </p>
          <div class="sc-arrows">
            <button type="button" class="sc-prev" aria-label="Bolsa anterior">←</button>
            <button type="button" class="sc-next" aria-label="Próxima bolsa">→</button>
          </div>
        </div>
      </div>
      <ul class="sc-thumbs" role="list">
        {bags.map((b, i) => (
          <li>
            <button type="button" class={`bag-name${i === 0 ? ' is-on' : ''}`} data-i={i} data-name={b.name} data-lessons={b.lessons} data-tone={b.tone} data-slug={b.hasBag ? b.slug : ''} data-price={b.lessonPrice ?? ''} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={b.name}>
              <span class="sc-thumb" style={`--tone:${b.tone}`}>{b.thumb && <img src={b.thumb} alt="" width="240" height="135" loading="lazy" />}</span>
              <span class="sc-label">{b.name}</span>
            </button>
          </li>
        ))}
      </ul>
    </section>

    <!-- Método: acordeão de painéis -->
    <section class="method" id="metodo" aria-labelledby="metodo-h">
      <div class="method-intro reveal">
        <h2 id="metodo-h">Método Crochetin</h2>
        <p>Três níveis até o acabamento que a Crochetin vende, e uma etapa final para transformar a bolsa pronta em venda.</p>
      </div>
      <div class="stages">
        {stages.map((s, i) => (
          <details class="stage" name="stage" open={i === 0} style={`--i:${i}`}>
            <summary><span>{s.name}</span></summary>
            <div class="stage-body">
              <p>{s.text}</p>
              {s.img && <Image src={s.img} alt="" widths={[220, 360]} sizes="200px" />}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Prova: o que as clientes falam -->
    <section class="proof" aria-labelledby="clientes-h">
      <div class="proof-board">
        <div class="proof-head reveal">
          <h2 id="clientes-h">As clientes falam</h2>
          <p>Mensagens reais de quem comprou bolsas Crochetin. É esse padrão que o Treinamento ensina. Toque numa mensagem para ampliar.</p>
        </div>
        {chats.map((c, i) => (
          <figure class="proof-tile reveal">
            <button type="button" class="proof-zoom" data-big={chatsBig[i].src} aria-label={`Ampliar a mensagem de cliente ${i + 1}`}>
              <Image src={c} alt={`Mensagem de cliente elogiando uma bolsa Crochetin (${i + 1})`} widths={[260, 420]} sizes="(max-width: 700px) 45vw, 20vw" />
              <span class="proof-hint" aria-hidden="true">Ampliar</span>
            </button>
          </figure>
        ))}
      </div>
      <dialog class="proof-dialog" aria-label="Mensagem de cliente ampliada">
        <img src="" alt="Mensagem de cliente ampliada" />
        <button type="button" class="proof-close">Fechar</button>
      </dialog>
    </section>

    <!-- Sobre: painel escuro com retrato em arco -->
    <section class="about" aria-labelledby="sobre-h">
      <div class="about-panel">
        <div class="about-left">
          <h2 id="sobre-h">Da arquitetura ao crochê</h2>
          <div class="about-portrait">
            <Image src={mariliaVerde} alt="Marília Lucena, fundadora da Crochetin" widths={[400, 700]} sizes="(max-width: 860px) 86vw, 38vw" />
          </div>
        </div>
        <div class="about-right reveal">
          <div>
            <h3>Quem é a Marília</h3>
            <p>Formada em Arquitetura e Urbanismo, Marília Lucena encontrou no crochê a sua paixão e fundou a Crochetin, marca de bolsas de crochê de alto padrão.</p>
          </div>
          <div>
            <h3>O que ela ensina</h3>
            <p>As mesmas bolsas que a Crochetin vende, com o processo do ateliê: estrutura, forma, acabamento e o que fazer para vender cada peça.</p>
          </div>
          <a class="arch-btn arch-btn-accent" href={checkout('sobre')} target="_blank" rel="noopener">Quero o Treinamento</a>
        </div>
      </div>
    </section>

    <!-- O que vem junto com as aulas -->
    <section class="extras" aria-labelledby="extras-h">
      <div class="extras-head reveal">
        <h2 id="extras-h">O que vem junto</h2>
        <p>Além das 9 bolsas em {totalLessons} aulas, o Treinamento traz o que a Marília usa para vender as bolsas dela.</p>
      </div>
      <ol class="extras-list" role="list">
        {extras.map(([t, d], i) => (
          <li class="extras-item reveal">
            <span class="extras-n" aria-hidden="true">{i + 1}</span>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Preço: planos em degraus -->
    <section class="pricing" id="preco" aria-labelledby="preco-h">
      <div class="plans">
        <h2 id="preco-h">Por onde começar</h2>
        <article class="plan plan-1 reveal">
          <div class="plan-top">
            <h3>Aula avulsa</h3>
            <p class="plan-from">a partir de</p>
            <p class="plan-price">R$ 37</p>
            <ul role="list"><li>Uma bolsa à sua escolha</li><li>Receita em e-book</li><li>O preço varia conforme a bolsa</li></ul>
          </div>
          <a class="plan-btn" href="/aulas-avulsas">Ver as aulas avulsas</a>
        </article>
        <article class="plan plan-2 reveal">
          <div class="plan-top">
            <h3>Já tem uma aula</h3>
            <p class="plan-from">a partir de</p>
            <p class="plan-price">R$ 140</p>
            <ul role="list"><li>O Treinamento completo descontando o valor da aula que você já comprou</li><li>Para quem já comprou uma aula avulsa</li></ul>
          </div>
          <a class="plan-btn" href={upgradeWhatsapp} target="_blank" rel="noopener">Pedir pelo WhatsApp</a>
        </article>
        <article class="plan plan-3 reveal">
          <div class="plan-top">
            <h3>Treinamento completo</h3>
            <p class="plan-price">R$ 197</p>
            <p class="plan-note">ou 12x de R$ 20,37</p>
            <ul role="list">
              <li>9 bolsas em {totalLessons} aulas</li>
              <li>Método Crochetin em 3 níveis</li>
              <li>E-books com todas as receitas</li>
              <li>Precificação, embalagem e envio</li>
              <li>Suporte pelo WhatsApp com a Marília</li>
              <li>Certificado e novos modelos</li>
            </ul>
          </div>
          <a class="plan-btn" href={checkout('preco')} target="_blank" rel="noopener">Quero o Treinamento</a>
        </article>
      </div>
      <div class="guarantee reveal">
        <Image src={garantia} alt="Selo de garantia de 7 dias" widths={[140, 240]} sizes="120px" />
        <p><strong>7 dias para testar.</strong> Assista às aulas e comece a sua primeira bolsa. Se não for para você, peça o reembolso pela Hotmart dentro de 7 dias.</p>
      </div>
    </section>

    <!-- Dúvidas -->
    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Dúvidas comuns</h2>
      <div class="faq-list">
        {faq.map((f) => (
          <details name="faq" class="faq-item">
            <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
            {f.a ? <p>{f.a}</p> : <p class="pending">Resposta a confirmar com a Marília.</p>}
          </details>
        ))}
        <p class="faq-help">Ficou outra dúvida? <a href={whatsapp} target="_blank" rel="noopener">Fale com a Crochetin no WhatsApp</a>.</p>
      </div>
    </section>

    <!-- Fechamento: as bolsas voltam -->
    <section class="cta" aria-labelledby="cta-h">
      <div class="cta-object" aria-hidden="true">
        <Image src={marilia} alt="" widths={[700, 1200]} sizes="(max-width: 860px) 130vw, 66vw" />
      </div>
      <div class="cta-text reveal">
        <h2 id="cta-h">Sua primeira bolsa, hoje</h2>
        <p>Acesso imediato às {totalLessons} aulas, no celular ou no computador.</p>
        <p class="cta-price">R$ 197 ou 12x de R$ 20,37</p>
        <a class="arch-btn" href={checkout('final')} target="_blank" rel="noopener">Quero o Treinamento</a>
      </div>
    </section>

    <!-- Rodapé: a marca em blocos -->
    <footer class="foot">
      <div class="foot-mark" aria-label="Crochetin" role="img">
        {wordmark.map((l, i) => (
          <span style={`--h:${[100, 78, 92, 66, 100, 84, 70, 96, 88][i]}%;--c:${blockTones[i % blockTones.length]};--fc:${i % blockTones.length === 2 ? '#3e2f25' : '#f4efe7'}`}>{l}</span>
        ))}
      </div>
      <div class="foot-cols">
        <nav aria-label="Rodapé">
          <a href="/catalogo">Bolsas prontas</a>
          <a href="/aulas-avulsas">Aulas avulsas</a>
          <a href="https://instagram.com/crochetinatelie" target="_blank" rel="noopener">Instagram</a>
          <a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        </nav>
        <p class="foot-legal">Crochetin · CNPJ 61.929.288/0001-78<br />Maceió/AL · <a href="mailto:crochetin@hotmail.com">crochetin@hotmail.com</a><br /><a href="/privacidade">Política de privacidade</a> · <a href="#" data-cookie-prefs>Preferências de cookies</a></p>
      </div>
      <div class="foot-last">
        <p>Reembolso em até 7 dias pela Hotmart</p>
        <a class="arch-btn arch-btn-small" href="#topo">Voltar ao topo</a>
      </div>
    </footer>

    <!-- Barra fixa de compra no celular (aparece depois do topo, some perto do preço e do fechamento) -->
    <div class="buybar" aria-hidden="true">
      <p><strong>R$ 197</strong><span>ou 12x de R$ 20,37</span></p>
      <a class="buybar-btn" href={checkout('barra')} target="_blank" rel="noopener" tabindex="-1">Quero o Treinamento</a>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  const root = document.querySelector('.tr');
  if (root) {
    root.classList.add('js');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Vitrine: escolher uma bolsa troca a foto, a cor do arco e o fato
    const names = root.querySelectorAll('.bag-name');
    const imgs = root.querySelectorAll('.bag-img');
    const arch = root.querySelector('.showcase-arch');
    const fact = root.querySelector('.showcase-fact');
    const pick = (btn) => {
      const i = btn.dataset.i;
      names.forEach((n) => { n.classList.toggle('is-on', n === btn); n.setAttribute('aria-pressed', String(n === btn)); });
      imgs.forEach((im) => im.classList.toggle('is-on', im.dataset.i === i));
      if (arch) arch.style.setProperty('--tone', btn.dataset.tone || '#c09a6b');
      if (fact) {
        fact.querySelector('[data-f=n]').textContent = String(Number(i) + 1).padStart(2, '0');
        fact.querySelector('[data-f=name]').textContent = btn.dataset.name;
        fact.querySelector('[data-f=lessons]').textContent = btn.dataset.lessons + ' aulas e a receita em e-book, dentro do Treinamento';
        const bagA = fact.querySelector('[data-f=bag]'); const lesA = fact.querySelector('[data-f=lesson]');
        bagA.hidden = !btn.dataset.slug; if (btn.dataset.slug) bagA.href = '/catalogo/' + btn.dataset.slug;
        lesA.hidden = !btn.dataset.price; lesA.textContent = 'Aula avulsa R$ ' + btn.dataset.price;
      }
    };
    names.forEach((btn) => btn.addEventListener('click', () => pick(btn)));
    const step = (d) => {
      const cur = [...names].findIndex((n) => n.classList.contains('is-on'));
      pick(names[(cur + d + names.length) % names.length]);
    };
    const prev = root.querySelector('.sc-prev'); const next = root.querySelector('.sc-next');
    if (prev) prev.addEventListener('click', () => step(-1));
    if (next) next.addEventListener('click', () => step(1));

    // Vídeo: troca a capa pelo player do YouTube (modo de privacidade) só quando a pessoa clica
    const play = root.querySelector('.video-play');
    if (play) play.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = 'https://www.youtube-nocookie.com/embed/' + play.dataset.id + '?autoplay=1&rel=0&playsinline=1';
      f.title = 'Vídeo da Marília sobre o Treinamento Crochetin';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      play.replaceWith(f);
      if (typeof window.gtag === 'function') window.gtag('event', 'play_video', { video_id: play.dataset.id });
    });

    // Prova: tocar numa mensagem abre a versão grande
    const dlg = root.querySelector('.proof-dialog');
    if (dlg && typeof dlg.showModal === 'function') {
      const big = dlg.querySelector('img');
      root.querySelectorAll('.proof-zoom').forEach((b) => b.addEventListener('click', () => {
        big.src = b.dataset.big; dlg.showModal();
      }));
      dlg.querySelector('.proof-close').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    }

    // Barra fixa no celular: só entre o topo e o preço, e nunca por cima do aviso de cookies
    const bar = root.querySelector('.buybar');
    const hero = root.querySelector('.hero');
    const stops = [root.querySelector('#bolsas'), root.querySelector('#preco'), root.querySelector('.cta'), root.querySelector('.foot')].filter(Boolean);
    if (bar && hero && 'IntersectionObserver' in window) {
      let heroOut = false; const seen = new Set();
      const sync = () => {
        const cookie = document.getElementById('cookie-bar');
        const show = heroOut && seen.size === 0 && !(cookie && !cookie.hidden);
        bar.classList.toggle('is-on', show);
        bar.setAttribute('aria-hidden', String(!show));
        bar.querySelector('a').tabIndex = show ? 0 : -1;
      };
      new IntersectionObserver(([e]) => { heroOut = !e.isIntersecting; sync(); }).observe(hero);
      const so = new IntersectionObserver((es) => { es.forEach((e) => e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)); sync(); });
      stops.forEach((el) => so.observe(el));
      document.addEventListener('click', () => setTimeout(sync, 50));
    }

    // Movimento de assinatura: troca lenta das fotos do topo
    const fades = root.querySelectorAll('.hero-arch .fade');
    if (!reduce && fades.length > 1) {
      let k = 0;
      setInterval(() => {
        if (document.hidden) return;
        fades[k].classList.remove('is-on');
        k = (k + 1) % fades.length;
        fades[k].classList.add('is-on');
      }, 5600);
    }

    // Entradas por seção (uma vez), com conteúdo visível sem script
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -12% 0px' });
      root.querySelectorAll('.reveal, .stage, .bag-name, .faq-item, .foot-mark span').forEach((el, i) => {
        el.style.setProperty('--d', `${(i % 6) * 75}ms`);
        el.classList.add('will-in');
        io.observe(el);
      });
    }
  }
</script>

