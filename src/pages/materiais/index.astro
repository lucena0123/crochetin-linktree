---
/**
 * Materiais (v2, estilo da marca). Os materiais são vendidos na vitrine da
 * Crochetin na Shopee (afiliação): a página leva para lá e avisa da comissão.
 * As listas de bolsas por fio saem de products.json (campo material).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import mariliaAgulhas from '../../assets/materiais-marilia.jpg';
import BrandChrome from '../../components/BrandChrome.astro';
import productsData from '../../data/products.json';
import type { Product } from '../../types/product';
import '../../styles/brand.css';

const shopeeUrl = 'https://collshp.com/crochetin?share_channel_code=1&view=storefront';
const bags = (productsData.products as Product[]).filter((p) => p.inStock !== false);
const names = (test: (m: string) => boolean) =>
  bags.filter((p) => test((p.material || '').toLowerCase())).map((p) => p.name.replace(/^Bag /, ''));
const nautico = names((m) => m.includes('náutico'));
const malha = names((m) => m.includes('malha'));
const list = (arr: string[]) => (arr.length > 1 ? `${arr.slice(0, -1).join(', ')} e ${arr[arr.length - 1]}` : arr[0] ?? '');

const groups = [
  { title: 'Fio náutico premium', text: `Firme e com brilho, dá estrutura à bolsa. Usado nas bolsas ${list(nautico)}.`, tone: '#c09a6b' },
  { title: 'Fio de malha premium', text: `Macio e encorpado, com textura marcante. Usado nas bolsas ${list(malha)}.`, tone: '#d9c7ad' },
  { title: 'Alças e acessórios', text: 'Correntes, argolas, mosquetões, fechos e alças em metal dourado ou prata.', tone: '#a67d4f' },
  { title: 'Agulhas e kits', text: 'Agulhas de crochê e kits com o necessário para montar uma bolsa.', tone: '#6b5642' },
];
---

<BaseLayout
  title="Materiais | Crochetin"
  description="Fios, alças e acessórios para fazer bolsas de crochê como as da Crochetin, na vitrine da Crochetin na Shopee."
  wide
>
  <main class="b mt">
    <BrandChrome part="top" />

    <div class="mt-head">
      <div class="mt-head-text">
        <h1>Materiais</h1>
        <p>Os fios, as alças e os acessórios que aparecem nas bolsas da Crochetin, reunidos numa vitrine na Shopee.</p>
        <a class="b-arch-btn" href={shopeeUrl} target="_blank" rel="noopener" data-track="materiais_topo">Ver a vitrine na Shopee</a>
      </div>
      <div class="mt-head-photo" aria-hidden="true">
        <Image src={mariliaAgulhas} alt="" widths={[400, 674]} sizes="(max-width: 700px) 78vw, 40vw" loading="eager" />
      </div>
    </div>

    <ul class="mt-groups" role="list">
      {groups.map((g) => (
        <li class="mt-group reveal">
          <span class="mt-mark" style={`--tone:${g.tone}`} aria-hidden="true"></span>
          <h2>{g.title}</h2>
          <p>{g.text}</p>
        </li>
      ))}
    </ul>

    <section class="mt-end reveal" aria-labelledby="mt-end-h">
      <h2 id="mt-end-h">Tudo num lugar só</h2>
      <p>A compra é feita na Shopee, com o pagamento e a entrega da Shopee. A Crochetin recebe uma comissão de afiliada pelas compras feitas pela vitrine, sem custo extra para você.</p>
      <div class="mt-end-actions">
        <a class="b-arch-btn is-light" href={shopeeUrl} target="_blank" rel="noopener" data-track="materiais_final">Ver a vitrine na Shopee</a>
        <a class="mt-learn" href="/treinamento">Quer aprender a fazer as bolsas? Conheça o Treinamento</a>
      </div>
    </section>

    <BrandChrome part="foot" />
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.querySelector('.b');
    if (!root) return;
    root.querySelectorAll('[data-track]').forEach(function (a) {
      a.addEventListener('click', function () {
        if (typeof gtag === 'function') gtag('event', 'click_materiais', { link_location: a.dataset.track });
      });
    });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    root.querySelectorAll('.reveal').forEach(function (el, i) {
      el.style.setProperty('--d', (i % 4) * 80 + 'ms');
      el.classList.add('will-in');
      io.observe(el);
    });
  })();
</script>

<style>
  .mt-head { display: grid; grid-template-columns: 7fr 5fr; gap: var(--m); align-items: end; padding-top: clamp(16px, 3vw, 40px); }
  .mt-head-text { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-bottom: clamp(16px, 4vw, 56px); }
  .mt-head-text p { max-width: 42ch; }
  .mt-head-photo { aspect-ratio: 4 / 5; background: var(--deep); border-radius: 999px 999px 0 0; overflow: hidden; }
  .mt-head-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }

  .mt-groups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: clamp(56px, 8vw, 120px) !important; }
  .mt-group { background: var(--sand); padding: 24px; display: flex; flex-direction: column; gap: 12px; min-height: 260px; }
  .mt-mark { width: 40px; height: 46px; background: var(--tone); border-radius: 999px 999px 0 0; }
  .mt-group h2 { font-size: var(--t-m); margin-top: 8px; }
  .mt-group p { font-size: var(--t-s); }

  .mt-end { margin-top: clamp(72px, 10vw, 160px); background: var(--ink); color: var(--ground); padding: clamp(32px, 5vw, 72px); display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .mt-end h2 { color: var(--pale); }
  .mt-end p { max-width: 56ch; }
  .mt-end-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; margin-top: 8px; }
  .mt-learn { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--t-s); font-weight: 600; text-underline-offset: 4px; color: var(--ground) !important; }

  @media (max-width: 1024px) {
    .mt-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .mt-head { grid-template-columns: minmax(0, 1fr); }
    .mt-head-photo { order: -1; width: 78%; justify-self: center; }
    .mt-head-text .b-arch-btn, .mt-end .b-arch-btn { align-self: stretch; }
    .mt-groups { grid-template-columns: minmax(0, 1fr); }
    .mt-group { min-height: 0; }
  }
</style>
